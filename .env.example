# Aether BTC Configuration

# Environment
AETHER_BTC_ENVIRONMENT=development  # development | paper | live

# Database
AETHER_BTC_DB_HOST=localhost
AETHER_BTC_DB_PORT=5432
AETHER_BTC_DB_NAME=aether_btc
AETHER_BTC_DB_USER=aether_btc
AETHER_BTC_DB_PASSWORD=

# Binance API (Futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true  # Use testnet for paper trading

# Trading
AETHER_BTC_TRADING_INITIAL_CAPITAL=1000.0
AETHER_BTC_TRADING_MAX_LEVERAGE=20.0
AETHER_BTC_TRADING_MAX_POSITIONS=3
AETHER_BTC_TRADING_COMMISSION_RATE=0.0004  # 0.04% taker fee

# Telegram Alerts
AETHER_BTC_ALERT_TELEGRAM_TOKEN=
AETHER_BTC_ALERT_TELEGRAM_CHAT_ID=

# Logging
AETHER_BTC_LOG_LEVEL=INFO
AETHER_BTC_LOG_FORMAT=json
